# auto-network-location —— 网络识别规则
#
# 拷到 ~/.wifi-loc-control/locations.env 后修改。每张网络一个编号组。
# LOCATION_n_NAME 是要切换过去的 macOS 位置名，地址/MAC 这一对识别这张网络。
#
# MAC 必须属于「Mac 在这张网络上时一定在场」的设备，不必是 Mac 当前的网关；上游路由器
# 是个好选择。在连到那张网络时采集每一对：
#
#     ./wifi-loc-detect.sh --print-mac <设备地址>
#
# 一组还可以写一台可选的目标设备：本位置自己的设置所依赖的那一台（它的网关或 DNS）。
# 它回答第二个问题——「这还是我写设置时的那张网吗？」——缺省等于上面的特征设备，所以多数
# 网络不需要额外配置。
#
# 这个文件被脚本 source，所以它是代码：自己持有它、权限 600，不要从不可信来源拷一份。

# 语言：只改变 --help 文本与通知正文，日志与状态文件固定英文。只认 zh_CN（默认）与 en；
# 环境变量 WLC_LANG 可临时覆盖。写成别的值（例如 zh-CN）会回落到 zh_CN，并在日志里留
# 一行说明——语言写错不影响判定与切换。
SCRIPT_LANG="zh_CN"

# 家庭网络，靠它的上游路由器识别
LOCATION_1_NAME="Home"
LOCATION_1_IP="192.0.2.1"
LOCATION_1_MAC="00:00:5e:00:53:01"

# 可选。要写就写全：目标字段不合法会跳过整组，而不是被静默忽略。
# LOCATION_1_TARGET_IP="192.0.2.100"
# LOCATION_1_TARGET_MAC="00:00:5e:00:53:02"
# 另一张网络，靠它自己的路由器识别
# LOCATION_2_NAME="Office"
# LOCATION_2_IP="198.51.100.1"
# LOCATION_2_MAC="aa:bb:cc:dd:ee:ff"
